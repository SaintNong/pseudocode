# Repeatedly creates short strings and reads their lengths.
FUNCTION string_churn(n)
    checksum = 0
    FOR i = 0 TO n - 1
        value = "scsa" + "-lang"
        checksum = checksum + value.length
    END FOR
    RETURN checksum
END string_churn

checksum = string_churn(50000)
PRINT("Checksum: " + STRING(checksum))
