# Exercises dictionary allocation, integer keys, membership and lookup.
FUNCTION dictionary_ops(n)
    values = {}
    FOR i = 0 TO n - 1
        values[i] = i
    END FOR

    checksum = 0
    FOR i = 0 TO n - 1
        IF i IN values THEN
            checksum = checksum + values[i]
        END IF
    END FOR
    RETURN checksum
END dictionary_ops

checksum = dictionary_ops(8000)
PRINT("Checksum: " + STRING(checksum))
