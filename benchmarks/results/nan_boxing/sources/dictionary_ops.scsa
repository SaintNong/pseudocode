
FUNCTION benchmark(n)
    values = {}
    FOR i = 0 TO n - 1
        values[i] = i
    END FOR
    checksum = 0
    FOR i = 0 TO n - 1
        IF i IN values THEN
            checksum = checksum + values[i]
        END IF
    END FOR
    RETURN checksum
END benchmark

FOR warmup = 1 TO 2
    benchmark(40000)
END FOR

checksums = []
started = TIME()
FOR sample = 1 TO 5
    checksum = benchmark(40000)
    checksums.append(checksum)
END FOR
elapsed = TIME() - started
FOR checksum IN checksums
    PRINT("Checksum: " + STRING(checksum))
END FOR
PRINT("BatchKernel: " + STRING(elapsed))
